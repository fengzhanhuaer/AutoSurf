{
  "manifest_version": 3,
  "minimum_chrome_version": "130",
  "name": "NetSurf",
  "version": "0.4.89",
  "description": "NetSurf Dashboard：PT 站点签到、NodeSeek/InvitesFun 定时签到、浏览器设置与所有网站 Cookie 的备份还原。",
  "permissions": ["storage", "alarms", "scripting", "offscreen"],
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"},
  "optional_permissions": ["cookies"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": ["https://piggo.me/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "打开 NetSurf Dashboard"},
  "content_scripts": [{
    "matches": ["https://piggo.me/*"],
    "js": ["catalog.js", "site-rules.js", "sites.js", "profile-api.js", "hdsky.js", "opencd.js", "ptsbao.js", "freefarm.js", "pt52.js", "piggo.js", "content.js"],
    "run_at": "document_idle"
  }]
}
